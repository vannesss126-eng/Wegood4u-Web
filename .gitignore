# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
firebase.js
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
qr-codes/

# raw scraped originals (156MB) — processed picks go to public/images
assets-raw/

# playwright (0.4 smoke tests)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next-sitemap output — regenerated by `postbuild` on every build, so committing
# it only creates churn and lets a stale sitemap outlive a route change.
/public/sitemap.xml
/public/sitemap-0.xml
/public/robots.txt
