{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/reset-password",
        "destination": "/reset-password.html"
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://wegood4u.com",
        "type": 301
      }
    ]
  }
}
